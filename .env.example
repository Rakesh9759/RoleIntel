# Local-only PostgreSQL credentials. Do not reuse outside development.
POSTGRES_DB=roleintel
POSTGRES_USER=roleintel
POSTGRES_PASSWORD=roleintel_dev_only

# Run API tooling from the repository root to load this file.
# Keep these credentials consistent with POSTGRES_* above; URL-encode special characters.
DATABASE_URL=postgresql+psycopg://roleintel:roleintel_dev_only@localhost:5432/roleintel
